{
  "name": "bankos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "seed": "node --env-file-if-exists=.env dist/database/seed.js",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/money.test.js",
    "test:e2e": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/jest/bin/jest.js --runInBand test/bank.e2e.test.js",
    "test:all": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.6",
    "@mikro-orm/postgresql": "7.2.6",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "3.0.3",
    "ioredis": "^5.8.0",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "jest": "^30.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/*.test.js"
    ],
    "transform": {}
  }
}

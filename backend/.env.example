# Local Compose defaults. Use different secrets and HTTPS for real deployments.
POSTGRES_DB=bankos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_only
APP_DB_PASSWORD=local_bankos_only
DATABASE_URL=postgresql://bankos_app:local_bankos_only@localhost:5432/bankos
MIGRATION_DATABASE_URL=postgresql://postgres:local_postgres_only@localhost:5432/bankos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=local-demo-jwt-secret-change-before-deploy
PLATFORM_ADMIN_KEY=local-demo-platform-key-change-before-deploy
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
PORT=3000
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
RATE_LIMIT_IP=240
RATE_LIMIT_AUTH=25
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_USER=160
RATE_LIMIT_TENANT=400
RATE_LIMIT_MONEY=40
WEBHOOK_POLL_MS=1000
WEBHOOK_MAX_ATTEMPTS=6
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=BankOS-demo-2026!
